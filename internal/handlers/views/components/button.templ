package components

type Button struct {
	Text   string
	Attr   templ.Attributes
	Active bool
}

func NewButton(text string, attr templ.Attributes) *Button {
	return &Button{
		Text: text,
		Attr: attr,
	}
}

func (b *Button) SetText(text string) *Button {
	b.Text = text
	return b
}

func (b *Button) SetAttr(key string, value string) *Button {
	b.Attr[key] = value
	return b
}

func (b *Button) SetAttrs(attrs templ.Attributes) *Button {
	b.Attr = attrs
	return b
}

func (b *Button) SetActive(active bool) *Button {
	b.Active = active
	return b
}

func (b *Button) Templify() templ.Component {
	return ButtonComponent(*b)
}

templ ButtonComponent(b Button) {
	<button
		{ b.Attr... }
		if b.Active {
			class="
			disabled:bg-slate-600 
			rounded-md
			 bg-white 
			 px-3.5 
			 py-2.5 
			 text-sm 
			 font-semibold 
			 text-indigo-600 
			 shadow-sm 
			 hover:bg-indigo-600 
			 hover:text-white 
			 focus-visible:outline 
			 focus-visible:outline-2 
			 focus-visible:outline-offset-2 
			 focus-visible:outline-indigo-600"
		} else {
			class="
			 disabled:bg-slate-600 
			 rounded-md 
			 bg-indigo-600 
			 px-3.5 
			 py-2.5 
			 text-sm 
			 font-semibold 
			 text-white 
			 shadow-sm 
			 hover:bg-white
			 hover:text-indigo-600
			 focus-visible:outline 
			 focus-visible:outline-2 
			 focus-visible:outline-offset-2 
			 focus-visible:outline-indigo-600"
		}
	>
		{ b.Text }
		{ children... }
	</button>
}

templ SecondaryButtonComponent(b Button) {
	<button { b.Attr... } class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
		{ b.Text }
		{ children... }
	</button>
}
