package views

import (
	"github.com/labstack/echo/v4"
	"log"
	"sep_setting_mgr/internal/domain/models"
	common "sep_setting_mgr/internal/handlers/handlerscommon"
	"sep_setting_mgr/internal/handlers/views/components"
	"strconv"
	"time"
)

const TimeFormat string = "Mon Jan 2"

templ CalendarComponent(date time.Time, assignmentsMap models.AssignmentsByDate, rooms models.Rooms, admin bool, r *echo.Echo) {
	<div
		id="up-nav"
		hx-swap-oob="true"
	></div>
	<div class="flex flex-col items-center text-center">
		<h1>Calendar</h1>
		@WeekComponent(getThisMonday(date), assignmentsMap, rooms, admin, r)
	</div>
}

const ButtonDateFormat string = "2006-01-02"

templ WeekComponent(date time.Time, dates models.AssignmentsByDate, rooms models.Rooms, admin bool, r *echo.Echo) {
	<h3>Week of</h3>
	<h2>{ date.Format(TimeFormat) } to { date.AddDate(0, 0, 4).Format(TimeFormat) } </h2>
	<div class="flex gap-2">
		@components.ButtonComponent(components.Button{
			Attr: templ.Attributes{
				"hx-get":      r.Reverse(string(common.AdminCalendar), date.AddDate(0, 0, -7).Format(ButtonDateFormat)),
				"hx-target":   "#details",
				"hx-push-url": "true",
			},
		}) {
			Previous
		}
		@components.ButtonComponent(components.Button{
			Attr: templ.Attributes{
				"hx-get":      r.Reverse(string(common.AdminCalendar), date.AddDate(0, 0, 7).Format(ButtonDateFormat)),
				"hx-target":   "#details",
				"hx-push-url": "true",
			},
		}) {
			Next
		}
	</div>
	<div class="grid gap-2 grid-cols-5">
		for i := 0; i < 5; i++ {
			@DaySimple(date.AddDate(0, 0, i), dates[models.NormalizeDate(date.AddDate(0, 0, i))], rooms, admin, r)
		}
	</div>
}

templ DaySimple(date time.Time, blocks models.AssignmentsByBlock, rooms models.Rooms, admin bool, r *echo.Echo) {
	<div>
		@components.TableWrapperComponent(components.TableData{
			Title: date.Format(TimeFormat),
		}) {
			<tbody class={ components.TableBodyClass }>
				if len(blocks) == 0 {
					@components.SubHeader("No Students", "large", 1, false, false, false)
				} else {
					for i:=0; i<4; i++ {
						if _, ok := blocks[i+1]; ok {
							@components.SubHeader("Block "+strconv.Itoa(i+1), "large", 1, false, false, false)
							for _, room := range rooms.SortByRoomPriority() {
								if _, ok := blocks[i+1][room.ID]; ok {
									@RoomSimple(date, room, blocks[i+1][room.ID], i+1, createOverBookedTracker(blocks[i+1][room.ID]), admin, r)
								}
							}
						}
					}
				}
			</tbody>
		}
	</div>
}

templ RoomSimple(date time.Time, room *models.Room, assignments models.Assignments, block int, tracker map[int]bool, admin bool, r *echo.Echo) {
	<tr
		if admin {
			hx-get={ r.Reverse(common.AdminCalendarDetails.String(), date.Format(ButtonDateFormat), block, room.ID) }
		} else {
			hx-get={ r.Reverse(common.DBCalendarDetails.String(), date.Format(ButtonDateFormat), block, room.ID) }
		}
		hx-push-url="true"
		hx-target="#details"
		class="cursor-pointer"
	>
		@components.SubHeader(simpleRoomDataText(room, assignments), "large", 1, determineWarning(room.ID, tracker), grayedOut(assignments), greenBackground(room.ID, true))
	</tr>
}

func simpleRoomDataText(room *models.Room, assignments models.Assignments) string {
	if room.ID == -1 {
		return strconv.Itoa(len(assignments)) + " unassigned"
	}
	return strconv.Itoa(len(assignments)) + " in " + room.Number
}

func grayedOut(assignments models.Assignments) bool {
	if len(assignments) == 0 {
		return true
	}
	return false
}

var tracker map[int]bool

templ DayComponent(date time.Time, blocks models.AssignmentsByBlock, block int, rooms models.Rooms, room *models.Room, admin bool, r *echo.Echo) {
	<div
		id="up-nav"
		hx-swap-oob="true"
	>
		@components.NewButton("Back to Calendar", templ.Attributes{
			"hx-get":      r.Reverse(common.AdminCalendar.String(), date.Format("2006-01-02")),
			"hx-target":   "#details",
			"hx-push-url": "true",
		}).Templify()
	</div>
	<div class="flex flex-col gap-2 items-center">
		<div class="flex flex-row gap-1 justify-center">
			for i:=0; i<4; i++ {
				if _, ok := blocks[i+1]; ok {
					if admin {
						@components.NewButton(strconv.Itoa(i+1), templ.Attributes{
							"hx-get":      r.Reverse(common.AdminCalendarDetails.String(), date.Format("2006-01-02"), i+1, room.ID),
							"hx-target":   "#details",
							"hx-push-url": "true",
						}).SetActive(i+1 == block).Templify()
					} else {
						@components.NewButton(strconv.Itoa(i+1), templ.Attributes{
							"hx-get":      r.Reverse(common.DBCalendarDetails.String(), date.Format("2006-01-02"), i+1, room.ID),
							"hx-target":   "#details",
							"hx-push-url": "true",
						}).SetActive(i+1 == block).Templify()
					}
				} else {
					@components.NewButton(strconv.Itoa(i+1), templ.Attributes{
						"hx-get":      r.Reverse(common.AdminCalendarDetails.String(), date.Format("2006-01-02"), i+1, room.ID),
						"hx-target":   "#details",
						"hx-push-url": "true",
					}).SetAttr("disabled", "true").Templify()
				}
			}
		</div>
		@NewBlockComponent(date, block, rooms, room, blocks[block], admin, r).Templify()
	</div>
}

type BlockComponentStruct struct {
	date         time.Time
	block        int
	rooms        models.Rooms
	selectedRoom *models.Room
	assignments  models.AssignmentsByRoom
	admin        bool
	router       *echo.Echo
}

func NewBlockComponent(date time.Time, block int, rooms models.Rooms, selectedRoom *models.Room, assignments models.AssignmentsByRoom, admin bool, r *echo.Echo) *BlockComponentStruct {
	b := &BlockComponentStruct{
		date:         date,
		block:        block,
		rooms:        rooms,
		selectedRoom: selectedRoom,
		assignments:  assignments,
		admin:        admin,
		router:       r,
	}
	if selectedRoom != nil {
		b.selectedRoom = selectedRoom
	} else {
		for _, room := range rooms {
			if _, ok := assignments[room.ID]; ok {
				b.selectedRoom = room
				break
			}
		}
	}
	return b
}

func (b *BlockComponentStruct) Templify() templ.Component {
	return BlockComponent(b)
}

templ BlockComponent(b *BlockComponentStruct) {
	<div class="flex flex-row gap-1 justify-center">
		for _, room := range b.rooms.SortByRoomPriority() {
			if _, ok := b.assignments[room.ID]; ok {
				@components.NewButton(room.Number, templ.Attributes{
					"hx-get":      b.router.Reverse(common.AdminCalendarDetails.String(), b.date.Format("2006-01-02"), b.block, room.ID),
					"hx-target":   "#details",
					"hx-push-url": "true",
				}).SetActive(room == b.selectedRoom).Templify()
			}
		}
	</div>
	if b.selectedRoom != nil {
		@NewRoomComponent(b.date, b.block, b.selectedRoom, b.assignments[b.selectedRoom.ID], b.admin, b.router).Templify()
	} else {
		<p>Please select a room</p>
	}
}

var warning bool

func determineWarning(roomID int, tracker map[int]bool) bool {
	warning = roomID == -1 || tracker[roomID]
	return warning
}

type RoomComponentStruct struct {
	date        time.Time
	block       int
	room        *models.Room
	assignments models.Assignments
	tracker     map[int]bool
	admin       bool
	router      *echo.Echo
}

func NewRoomComponent(date time.Time, block int, room *models.Room, assignments models.Assignments, admin bool, r *echo.Echo) *RoomComponentStruct {
	rc := &RoomComponentStruct{
		date:        date,
		block:       block,
		room:        room,
		assignments: assignments,
		admin:       admin,
		router:      r,
	}
	rc.tracker = createOverBookedTracker(assignments)
	return rc
}

func (r *RoomComponentStruct) Templify() templ.Component {
	return RoomComponent(r)
}

templ RoomComponent(r *RoomComponentStruct) {
	if r.room.ID == -1 && r.admin {
		<tr>
			@components.NewButton("Auto-Assign", templ.Attributes{
				"hx-get":    r.router.Reverse(common.AutoAssign.String(), r.date.Format("2006-01-02"), r.block),
				"hx-target": "#details",
			}).Templify()
		</tr>
	}
	if len(r.assignments) == 0 {
		<tr>
			@components.TableCell("No students", false)
		</tr>
	} else {
		@components.TableWrapperComponent(components.TableData{
			Title: r.date.Format(TimeFormat),
			ID:    "day-details-" + r.date.Format(TimeFormat),
		}) {
			@components.TableHeaderComponent([]string{
				"First",
				"Last",
				"Test",
				"1:1",
			},
			) {
				<tr>
					@components.SubHeader("Block "+strconv.Itoa(r.block), "large", 5, false, r.room.ID == -1, false)
				</tr>
				<tr>
					@components.SubHeader(r.room.Number, "large", 5, createOverBookedTracker(r.assignments)[r.room.ID], grayedOut(r.assignments), greenBackground(r.room.ID, true))
				</tr>
			}
			<tbody class={ components.TableBodyClass }>
				for _, assignment := range r.assignments {
					if r.admin {
						@components.TableRowComponent(components.Row{
							ID:   assignment.ID,
							Data: []string{assignment.Student.FirstName, assignment.Student.LastName, assignment.TestEvent.TestName, strconv.FormatBool(assignment.Student.OneOnOne)},
							Buttons: []components.TableButton{
								{
									Text: "Assign",
									Attr: templ.Attributes{
										"hx-get":      r.router.Reverse(string(common.ShowAssignRoomForm), assignment.ID),
										"hx-target":   "#modal",
										"hx-push-url": "true",
									},
								},
							},
							Warning: determineWarning(r.room.ID, tracker),
						})
					} else {
						@components.TableRowComponent(components.Row{
							ID:      assignment.ID,
							Data:    []string{assignment.Student.FirstName, assignment.Student.LastName, assignment.TestEvent.TestName, strconv.FormatBool(assignment.Student.OneOnOne)},
							Warning: determineWarning(r.room.ID, tracker),
						})
					}
				}
			</tbody>
		}
	}
}

func greenBackground(roomID int, green bool) bool {
	if roomID == -1 {
		return false
	} else if green {
		return true
	} else {
		return false
	}
}

func getRoom(assignment models.Assignment) string {
	return assignment.Room.Number
}

func getRoomNameCellID(assignmentID int) string {
	prefix := "room-name-cell-"
	return prefix + strconv.Itoa(assignmentID)
}

func roomCount(assignments []*models.Assignment) map[int]int {
	roomCounter := make(map[int]int)
	for _, assignment := range assignments {
		if assignment.Room != nil {
			roomCounter[assignment.Room.ID]++
		}
	}
	return roomCounter
}

func isOverBooked(room *models.Room, assignments []*models.Assignment) bool {
	var maxCapacity int
	// if any students in this room and block have one on one, max capacity is 1
	for _, assignment := range assignments {
		if assignment.Room == nil {
			continue
		}
		if assignment.Room.ID != room.ID {
			continue
		}
		if assignment.Student.OneOnOne {
			log.Printf("Room %s has a one on one accommodation", room.Number)
			maxCapacity = 1
			break
		} else {
			maxCapacity = room.MaxCapacity
		}
	}
	roomCounter := roomCount(assignments)
	if roomCounter[room.ID] > maxCapacity {
		log.Printf("Room %s is overbooked", room.Number)
		return true
	}
	log.Printf("Room %s is not overbooked", room.Number)
	log.Printf("Room count: %s ", strconv.Itoa(roomCounter[room.ID]))
	log.Printf("Max capacity: %s ", strconv.Itoa(maxCapacity))

	return false
}

func createOverBookedTracker(a models.Assignments) map[int]bool {
	var overbookedTracker = make(map[int]bool)
	for _, assignment := range a {
		// check if key is already in map
		if assignment.Room == nil {
			continue
		}
		if assignment.Room.ID == -1 {
			continue
		}
		if _, ok := overbookedTracker[assignment.Room.ID]; ok {
			continue
		}
		overbookedTracker[assignment.Room.ID] = isOverBooked(assignment.Room, a)
	}
	return overbookedTracker
}

const overBookedWarningClass = "text-red-500"

func getThisMonday(date time.Time) time.Time {
	return date.AddDate(0, 0, -int(date.Weekday())+1)
}
